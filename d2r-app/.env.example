# Copy to .env.local — never commit secrets

# Merch field app iframe (joey-surveys / company merch host)
# Staging/prod default (if unset): https://joey-surveys.vercel.app
NEXT_PUBLIC_MERCH_APP_URL=https://joey-surveys.vercel.app

# Clerk — when BOTH are set, middleware uses Clerk instead of DEV_AUTH
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Shopify Admin API (read sync — optional for offline twin)
# SHOPIFY_SHOP=your-shop.myshopify.com
# SHOPIFY_ADMIN_TOKEN=shpat_...
# SHOPIFY_API_VERSION=2024-10

# Shopify webhooks HMAC secret (required for POST /api/webhooks/shopify)
# SHOPIFY_WEBHOOK_SECRET=whsec_...

# Optional Bearer for automation stubs (POST /api/shopify/automations/*)
# CRON_SECRET=replace-with-long-random-string
